{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mochiboard",
  "identifier": "io.github.jessawolfe-ux.mochiboard",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mochiboard",
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#fbf8fc"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Jessa Wolfe",
    "copyright": "Free and open source",
    "category": "Productivity",
    "shortDescription": "A planning board with a tiny helper",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
